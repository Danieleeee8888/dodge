{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['host', 'status', 'createdAt'])",
        "host": { ".validate": "newData.isString() && newData.val().length > 0" },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'ready' || newData.val() === 'playing' || newData.val() === 'finished')"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "guest": { ".validate": "newData.isString()" },
        "state": {
          "$uid": {
            ".read": "auth != null",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['x', 'y', 'alive'])",
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
            "alive": { ".validate": "newData.isBoolean()" }
          }
        }
      }
    }
  }
}
