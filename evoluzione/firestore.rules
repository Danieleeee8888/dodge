rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email is string
             && request.auth.token.email == 'danielet88@gmail.com';
    }

    function canReadUser(uid) {
      return request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    function validDisplayNameOpt() {
      return !('displayName' in request.resource.data)
             || (request.resource.data.displayName is string
                 && request.resource.data.displayName.size() >= 1
                 && request.resource.data.displayName.size() <= 24
                 && request.resource.data.displayName.matches('^[^<>]{1,24}$'));
    }

    function validDisplayNameReq() {
      return request.resource.data.displayName is string
             && request.resource.data.displayName.size() >= 1
             && request.resource.data.displayName.size() <= 24
             && request.resource.data.displayName.matches('^[^<>]{1,24}$');
    }

    // Profilo utente: solo il proprietario può leggere e modificare
    match /users/{uid} {
      allow read: if canReadUser(uid);
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.username is string
                    && request.resource.data.email is string
                    && request.resource.data.role is string
                    && request.resource.data.role in ['user', 'admin']
                    && (
                      (request.resource.data.role == 'admin'
                        && request.resource.data.email == 'danielet88@gmail.com')
                      || request.resource.data.role == 'user'
                    )
                    && request.resource.data.gamesPlayed == 0
                    && request.resource.data.bestTime == 0
                    && validDisplayNameReq()
                    && request.resource.data.displayName == request.resource.data.username;
      allow update: if request.auth != null
                    && (request.auth.uid == uid || isAdmin())
                    && !('username' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('email' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('createdAt' in request.resource.data.diff(resource.data).affectedKeys())
                    && (
                      !('role' in request.resource.data.diff(resource.data).affectedKeys())
                      || (
                        isAdmin()
                        && request.resource.data.role in ['user', 'admin']
                        && (
                          (request.resource.data.role == 'admin'
                            && request.resource.data.email == 'danielet88@gmail.com')
                          || request.resource.data.role == 'user'
                        )
                      )
                    )
                    && validDisplayNameOpt();
      allow delete: if false;
    }

    // Statistiche aggregate (1 documento per utente)
    match /player_stats/{uid} {
      allow read: if canReadUser(uid);
      allow create, update: if request.auth != null
                            && (request.auth.uid == uid || isAdmin())
                            && request.resource.data.user_id == uid;
      allow delete: if false;
    }

    // Storico partite recenti (best-of-N e diagnostica missioni)
    match /recent_games/{gameId} {
      allow read: if request.auth != null
                  && (
                    (
                      resource != null
                      && resource.data.user_id is string
                      && (resource.data.user_id == request.auth.uid || isAdmin())
                    )
                    || isAdmin()
                  );
      allow create: if request.auth != null
                    && request.resource.data.user_id is string
                    && (request.resource.data.user_id == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // Indice username → uid: pubblicamente leggibile per check unicità,
    // creabile solo al momento della registrazione, mai modificabile
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && username.size() >= 3
                    && username.size() <= 20
                    && username.matches('^[a-z0-9_]+$');
      allow update, delete: if false;
    }

    // Punteggi storici: leggibili da tutti, scrivibili solo da utenti verificati,
    // mai modificabili o cancellabili (anti-cheat)
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.resource.data.uid == request.auth.uid
                    && validDisplayNameReq()
                    && request.resource.data.ms is int
                    && request.resource.data.ms > 0
                    && request.resource.data.ms <= 7200000;
      allow update, delete: if false;
    }

    // Classifica globale: un documento per utente (uid = chiave), solo il best time.
    // Aggiornabile solo se il nuovo ms è strettamente maggiore del precedente (anti-cheat).
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && validDisplayNameReq()
                    && request.resource.data.ms is int
                    && request.resource.data.ms > 0
                    && request.resource.data.ms <= 7200000;
      allow update: if request.auth != null
                    && request.auth.token.email_verified == true
                    && request.auth.uid == uid
                    && (
                      (
                        request.resource.data.ms > resource.data.ms
                        && request.resource.data.uid == uid
                        && validDisplayNameReq()
                      )
                      || (
                        request.resource.data.ms == resource.data.ms
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.uid == uid
                        && validDisplayNameReq()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['displayName', 'updatedAt'])
                      )
                    );
      allow delete: if false;
    }

    // Tutto il resto: negato
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
